{
  "name": "resume",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -n ui,worker -c blue,magenta npm:dev:ui npm:dev:worker",
    "dev:ui": "cd web && vite",
    "dev:worker": "wrangler dev",
    "build": "cd web && vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p web/tsconfig.app.json && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint .",
    "preview": "cd web && vite preview",
    "db:migrate": "wrangler d1 migrations apply resume-chats --local",
    "db:migrate:prod": "wrangler d1 migrations apply resume-chats --remote"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.4.18",
    "@visx/scale": "^3.12.0",
    "@visx/text": "^3.12.0",
    "@visx/wordcloud": "^3.12.0",
    "d3-array": "^3.2.4",
    "deep-chat-react": "^2.5.1",
    "framer-motion": "^11.0.8",
    "hono": "^4.13.11",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.1",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.5",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wrangler": "^4.144.0"
  }
}
